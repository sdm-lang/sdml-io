Module                  ::= 'module' Identifier Iri? ModuleVersion? ModuleBody

ModuleVersion           ::= "version" QuotedString? Iri

ModuleBody              ::= 'is' ImportStatement* Annotation* Definition* 'end'

ImportStatement         ::= ImportFromClause? 'import' ( Import | '[' Import+ ']' )

ImportFromClause        ::= 'from' ( AbsoluteModulePath | RelativeModulePath )

AbsoluteModulePath      ::= '::' RelativeModulePath?

RelativeModulePath      ::= Identifier ( '::' Identifier )*

Import                  ::= ( MemberImport | ModuleImport ) ImportRenameClause?

ModuleImport            ::= Identifer Iri?

MemberImport            ::= QualifiedIdentifier

ImportRenameClause      ::= 'as' Identifier

Annotation              ::= AnnotationProperty | Constraint

AnnotationProperty      ::= '@' IdentiferReference '=' Value

Definition              ::= ClassDef
                            | DatatypeDef
                            | DimensionDef
                            | EntityDef
                            | EnumDef
                            | EventDef
                            | MetricDef
                            | MetricGroupDef
                            | PropertyDef
                            | RdfDef
                            | StructureDef
                            | UnionDef

DatatypeDef             ::= 'datatype' Identifier
                            TypeRestriction 'opaque'? DatatypeBase DatatypeRestriction? 
                            AnnotationOnlyBody?

TypeRestriction         ::= "<-" | "←"

DatatypeBase            ::= IdentifierReference | BuiltinTypes

DatatypeRestriction     ::= '{' ( LengthRestricion 
                                  | DigitRestriction 
                                  | ValueRestriction 
                                  | TimezoneRestriction 
                                  | PatternRestriction )* '}'

LengthRestricion        ::= ( 'length' | 'maxLength' | 'minLength' )
                            '=' 'fixed'? Unsigned

DigitRestriction        ::= ( 'fractionDigits' | 'totalDigits' )
                            '=' 'fixed'? Unsigned

ValueRestriction        ::= ( 'maxExclusive' | 'maxInclusive' | 'minExclusive' | 'minInclusive' )
                            '=' 'fixed'? (SimpleValue | ValueConstructor)

TimezoneRestriction     ::= 'explicitTimezone' 
                            '=' 'fixed'? ( 'required' | 'prohibited' | 'optional' )

PatternRestriction      ::= 'pattern' '=' ( QuotedString | '[' QuotedString+']' )

AnnotationOnlyBody      ::= 'is' Annotation+ 'end'

DimensionDef            ::= 'dimension' Identifier DefinitionFromClause? DimensionBody?

DefinitionFromClause    ::= 'from' IdentifierReference 
                            ( DefinitionFromClauseWith | DefinitionFromClauseWithout )

DefinitionFromClauseWith::= 'with' ( '_' | IdentifierOrSequence )

DefinitionFromClauseWithout ::=
                            'without' IdentifierOrSequence

IdentifierOrSequence    ::= Identifier | '[' Identifier+ ']'

DimensionBody           ::= 'is' Annotation* DimensionIdentity DimensionParent* Member* 'end'

DimensionIdentity       ::= SourceEntity | EntityIdentity

DimensionParent         ::= 'parent' Identifier HasType IdentiferReference AnnotationOnlyBody?

SourceEntity            ::= 'source' IdentiferReference SourceMembers?

SourceMembers           ::= 'with' IdentifierOrSequence

EntityDef               ::= 'entity' Identifier DefinitionFromClause? EntityBody?

EntityBody              ::= 'is' Annotation* EntityIdentity Member* 'end'

EnumDef                 ::= 'enum' Identifier DefinitionFromClause? EnumBody?

EnumBody                ::= 'of' Annotation* ValueVariant* 'end'

ValueVariant            ::= Identifier AnnotationOnlyBody?

EventDef                ::= 'event' Identifier DefinitionFromClause? EventBody?

EventBody               ::= 'is' Annotation* SourceEntity Member* 'end'

MetricDef               ::= 'metric' MetricFunctionSignature AnnorationOnlyBody?

MetricFunctionSignature ::= Identifier ( '('  FunctionParameter+ ')' )? FunctionType

MetricGroupsDef         ::= 'metric' 'group' Identifier MetricEventBinding MetricGroupBody?

MetricEventBinding      ::= 'on' ( Identifier  HasType )? IdentifierReference

MetricGroupBody         ::= 'is' Annotation* ( InlineMetricDef | MetricRef )*

InlineMetricDef         ::= ClassFunctionDef

MetricRef               ::= 'ref' IdentifierReference AnnotationOnlyBody?

PropertyDef             ::= 'property' ( MemberDef |AnnotationMemberDef )

RdfDef                  ::= 'rdf' Identifier RdfTypes? AnnotationOnlyBody

RdfTypes                ::= ( 'a' | 'type' ) IdentifierRefOrSequence

IdentifierRefOrSequence ::= IdentifierReference | '[' IdentifierReference+ ']'

StructureDef            ::= 'structure' Identifier DefinitionFromClause? StructuredBody?

StructuredBody          ::= 'is' Annotation* Member* 'end'

UnionDef                ::= 'union' Identifier DefinitionFromClause? UnionBody?

UnionBody               ::= 'of' Annotation* TypeVariant* 'end'

TypeVariant             ::= IdentifierReference TypeVariantRename? AnnotationOnlyBody?

TypeVariantRename       ::= 'as' Identifier

ClassDef                ::= 'class' Identifier ClassTypeParameters? DefinitionFromClause? 
                            TypeClassBody?

ClassTypeParameters     ::= '(' TypeParameter+ ')'

TypeParameter           ::= Identifier ( TypeRestriction TypeRestrictionParameters )?

TypeRestrictionParameters ::=
                            TypeRestrictionParameter ( '+' TypeRestrictionParameter )*

TypeRestrictionParameter::= CardinalityReference? IdentifierReference 
                            '(' TypeRestrictionArgument+ ')'

TypeRestrictionArgument ::= '_' | TypeClassReference

TypeClassBody           ::= 'is' Annotation* ClassFunctionDef 'end'

ClassFunctionDef        ::= FunctionSignature FunctionBody? AnnotationOnlyBody?

EntityIdentity          ::= 'identity' Member

Member                  ::= MemberDef | PropertyRef

MemberDef               ::= Identifier TypeExpression AnnotationOnlyBody?

AnnotationMemberDef     ::= '@' MemberDef

PropertyRef             ::= 'ref' IdentifierReference

TypeExpression          ::= HasType Cardinality? TypeReference

HasType                 ::= "->" | "→"

TypeReference           ::=  UnknownType | IdentifierReference | BuiltinTypes | MappingType

UnknownType             ::= 'unknown'

MappingType             ::= '(' TypeReference HasType TypeReference ')'

Cardinality             ::= '{' SequenceOrdering? SequenceUniqueness? CardinalityInner '}'

CardinalityReference    ::= '{' SequenceOrdering? SequenceUniqueness? CardinalityInner?'}'

CardinalityInner        ::= Unsigned CardinalityRange?

CardinalityRange        ::= '..' Unsigned?

SequenceOrdering        ::= 'ordered' | 'unordered'

SequenceUniqueness      ::= 'unique' | 'nonunique'

Value                   ::=  SimpleValue
                             | ValueConstructor
                             | IdentifierReference
                             | MappingValue
                             | SequenceOfValues

SimpleValue             ::= Boolean
                            | Unsigned 
                            | Integer 
                            | Rational 
                            | Decimal 
                            | Double
                            | String 
                            | Iri 
                            | Binary

BuiltinTypes            ::= OwlTypes | XsdTypes | SdmlTypes

Boolean                 ::= Truth | Falsity

Truth                   ::= ( 'true' | '⊤' )

Falsity                 ::= ( 'false' | '⊥' )

NumericSign             ::= '+' | '-'

PositiveUnsigned        ::= [1-9] ASCII_DIGIT*

Unsigned                ::= '0' | PositiveUnsigned

Integer                 ::= NumericSign? Unsigned

Rational                ::= Integer ( '/' | '⁄' ) PositiveUnsigned

Decimal                 ::= Integer '.' ASCII_DIGIT+

double                  ::= Decimal ( 'e' | 'E' ) NumericSign? Integer

String                  ::= QuotedString LanguageTag?

QuotedString            ::= '"' ( Escape | NotAllowed )* '"'

NotAllowed              ::= [^\"#x00-#x08#x0B-#x1F#x7F]

UnicodeEscape           ::= '\\' ( CharacterEscape | UnicodeEscape )

CharacterEscape         ::= [\"\\/abefnrtv]

UnicodeEscape           ::= 'u{' HexPair ( HexPair ( HexPair )? )? '}'

HexPair                 ::= ASCII_HEX_DIGIT ASCII_HEX_DIGIT

LanguageTag             ::= '@' LanguageTagPrimary
                            LanguageTagExtended?
                            LanguageTagScript?
                            LanguageTagRegion?

LanguageTagPrimary      ::= ASCII_LETTER_LOWER ASCII_LETTER_LOWER ASCII_LETTER_LOWER?

LanguageTagExtended     ::= '-' ASCII_LETTER_UPPER ASCII_LETTER_UPPER ASCII_LETTER_UPPER

LanguageTagScript       ::= '-'
                            ASCII_LETTER_UPPER ASCII_LETTER_LOWER
                            ASCII_LETTER_LOWER ASCII_LETTER_LOWER

LanguageTagRegion       ::= '-'
                            ( ( ASCII_LETTER_UPPER ASCII_LETTER_UPPER )
                            | ( ASCII_DIGIT ASCII_DIGIT ASCII_DIGIT ) )

iri                     ::= '<'
                            ( [^<>\"{}|^`\#x00-#x20] | UnicodeEscape )*
                            '>'

binary                  ::= '#[' HexPair* ']'

ValueConstructor        ::= IdentifierReference '(' SimpleValue ')'

MappingValue            ::= SimpleValue HasType Value

SequenceOfValues        ::= SequenceValueConstraint? '['
                            ( SimpleValue | ValueConstructor | IdentifierReference )+
                            ']'

SequenceValueConstraint ::= '{' ( SequenceOrdering? SequenceUniqueness? ) '}'

IdentifierInitial       ::= UC_LETTER_UPPER | UC_LETTER_LOWER

IdentifierChar          ::= IdentifierInitial | UC_NUMBER_DECIMAL

Identifier              ::= IdentifierInitial IdentifierChar* ( '_' IdentifierChar+ )*

QualifiedIdentifier     ::= Identifier ':' Identifier

IdentifierReference     ::= QualifiedIdentifier | Identifier

LineComment             ::= CommentAligned | CommentLocal | CommentPage

CommentAligned          ::= ';' [^;] [^\r\n]*

CommentLocal            ::= ';;' [^;] [^\r\n]*

CommentPage             ::= ';;;' [^\r\n]*

Whitespace              ::= 
                  [^\f\n\r\t\v#x20#xa0#x1680#x2000#x200a#x2028#x2029#x202f#x205f#x3000#xfeff]

/* --------------------------------------------------------------------------- */

Constraint              ::= 'assert' Identifier ( InformalConstraint | FormalConstraint )

InformalConstraint      ::= '=' QuotedString ControlledLanguageTag?

ControlledLanguageTag   ::= '@' LanguageTagPrimary ControlledLanguageScheme?

ControlledLanguageScheme::= '-'
                            ASCII_LETTER  ASCII_LETTER  ASCII_LETTER
                            ASCII_LETTER? ASCII_LETTER? ASCII_LETTER?
                            ASCII_LETTER? ASCII_LETTER? ASCII_LETTER?

FormalConstraint        ::= ConstraintEnvironment? 'is' ConstraintSentence 'end'

ConstraintSentence      ::= SimpleSentence
                            | BooleanSentence
                            | ExpressionSentence
                            | QuantifiedSentence
                            | '(' ConstraintSentence ')'

SimpleSentence          ::= Atomic | Equation | Inequation

Atomic                  ::= Term ActualArguments

ActualArguments         ::='(' Term* ')'

Equation                ::= Term '=' Term

Inequation              ::= Term ( InequalityOperator
                                   | GreaterThanOperator
                                   | GreaterThanEqOperator
                                   | LessThanOperator
                                   | LessThanEqOperator ) Term

InequalityOperator      ::= '/=' | '≠'

GreaterThanOperator     ::= '>'

GreaterThanEqOperator   ::= '>=' | '≥'

LessThanOperator        ::= '<'

LessThanEqOperator      ::= '<=' | '≤'

BooleanSentence         ::= UnaryBooleanSentence | BinaryBooleanSentence

UnaryBooleanSentence    ::= NegationOperator ConstraintSentence

BinaryBooleanSentence   ::= ConstraintSentence (LogicalConjunction
                                                | LogicalDisjunction
                                                | LogicalExclDisjunction
                                                | LogicalImplication
                                                | LogicalBiconditional ) ConstraintSentence

LogicalNegation         ::= 'not' | '¬'

LogicalConjunction      ::= 'and' | '∧'

LogicalDisjunction      ::= 'or' | '∨'

LogicalExclDisjunction  ::= 'xor' | '⊻'

LogicalImplication      ::= 'implies' | '==>' | '⇒'

LogicalBiconditional    ::= 'iff' | '<==>' | '⇔'

ExpressionSentence      ::= SetExpressionSentence | ArithmeticExpressionSentence

SetExpressionSentence   ::= Term ( IsMemberOperator 
                                   | IsNotMemberOperator
                                   | SetComplementOperator 
                                   | SetIntersectionOperator
                                   | SetProductOperator 
                                   | SetSubsetOperator 
                                   | SetSubsetEqOperator 
                                   | SetSupsetOperator 
                                   | SetSupsetEqOperator 
                                   | SetUnionOperator ) Term

SetComplementOperator   ::= 'complement' | '∖'

SetIntersectionOperator ::= 'intersects' | '∩'

SetUnionOperator        ::= 'union' | '∪'

SetSubsetOperator       ::= 'subset' | '⊂'

SetSubsetEqOperator     ::= 'subseteq' | '⊆'

SetSupsetOperator       ::= 'supset' | '⊃'

SetSupsetEqOperator     ::= 'supseteq ' | '⊇'

SetProductOperator      ::= 'product' | '⨉'

IsMemberOperator        ::= 'in' | '∈'

IsMemberNotOperator     ::= (LogicalNegation IsMemberOperator) | '∉'

ArithmeticExpressionSentence ::= 
                            Term ( AdditionOperator 
                                   | SubtractionOperator 
                                   | MultiplicationOperator 
                                   | DivisionOperator 
                                   | ModuloOperator ) Term

AdditionOperator        ::= '+'

SubtractionOperator     ::= '-'

MultiplicationOperator  ::= '*' | '×'

DivisionOperator        ::= '/' | '÷'

ModuloOperator          ::= 'mod' | '%'

QuantifiedSentence      ::= QuantifiedVariableBinding+ ","? ConstraintSentence

QuantifiedVariableBinding ::= 
                            ( UniversalQuantifier 
                              | ExistentialQuantifier 
                              | ExistentialOneQuantifier
                              | ExistentialNotQuantifier ) QuantifiedVariable

UniversalQuantifier     ::= 'forall' | '∀'

ExistentialQuantifier   ::= 'exists' | '∃'

ExistentialOneQuantifier::= 'exists!' | '∃!'

ExistentialNotQuantifier::= LogicalNegation ExistentialQuantifier | '∄'

QuantifiedVariable      ::= Variable MembershipOperator Term

Variable                ::= Identifier ( HasType IdentiferReference )?

MembershipOperator      ::= IsMemberOperator | IsNotMemberOperator

IsMemberOperator        ::= 'in' | '∈'

IsMemberNotOperator     ::= (NegationOperator IsMemberOperator) | '∉'

Term                     ::= SequenceBuilder
                            | FunctionalTerm
                            | FunctionComposition
                            | IdentifierReference
                            | 'self'
                            | PredicateValue

SequenceBuilder         ::= '{' Variable+ '|' QuantifiedSentence '}'

FunctionalTerm          ::= Term ActualArguments

FunctionComposition     ::= ( 'self' | Identifier ) ( CompositionOperator Identifier )+

CompositionOperator     ::= '.' | '∘'

PredicateValue          ::= SimpleValue | SequenceOfPredicateValues

SequenceOfPredicateValues ::= 
                            '∅' | SequenceValueConstraint?
                            '[' ( SimpleValue | IdentifierReference )* ']'

/* --------------------------------------------------------------------------- */

ConstraintEnvironment   ::= 'with' EnvironmentDef+

FunctionDef             ::= FunctionSignature FunctionBody

FunctionSignature       ::= 'def' Identifier ( '(' FunctionParameter+ ')' )? FunctionType

FunctionParameter       ::= Identifier FunctionType

FunctionType            ::= HasType CardinalityReference? FunctionTypeRef

FunctionTypeRef         ::= IdentiferReference | BuiltinTypes | MappingType

FunctionBody            ::= ByDefinition ( ConstraintSentence | Term )

ByDefinition            ::= ':=' | '≔'