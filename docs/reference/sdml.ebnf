/* ---------------------------------------------------------------------------------------------- */
/* Module and Imports                                                                             */
/* ---------------------------------------------------------------------------------------------- */

module ::=
    'module' identifier iri? module_version? module_body

module_version ::=
    'version' quoted_string? iri

module_body ::=
    'is' import_statement* annotation* definition* 'end'

import_statement ::=
    from_clause? 'import'
    ( single_import | '[' single_import+ ']' )

import_from_clause ::=
    'from' ( absolute_module_path | relative_module_path )

absolute_module_path ::=
    '::' relative_module_path?

relative_module_path ::=
    identifier ( '::' identifier )*

single_import ::=
    ( member_import | module_import ) rename_as_clause?

module_import ::=
    identifer iri?

member_import ::=
    qualified_identifier

rename_as_clause ::=
    'as' identifier

/* ---------------------------------------------------------------------------------------------- */
/* Identifiers                                                                                    */
/* ---------------------------------------------------------------------------------------------- */

IDENTIFIER_INITIAL ::=
    UC_LETTER_UPPER | UC_LETTER_LOWER

IDENTIFIER_REST ::=
    IDENTIFIER_INITIAL | UC_UNICODE_NUMBER_DIGIT

identifier ::=
    IDENTIFIER_INITIAL IDENTIFIER_REST* ( '_' IDENTIFIER_REST+ )*

qualified_identifier ::=
    identifier ':' identifier

identifier_reference ::=
    qualified_identifier | identifier

/* ---------------------------------------------------------------------------------------------- */
/* Annotations (Properties)                                                                       */
/* ---------------------------------------------------------------------------------------------- */

annotation ::=
    annotation_property | constraint

annotation_property ::=
    '@' identifer_reference '=' value

/* ---------------------------------------------------------------------------------------------- */
/* Definitions & Members                                                                          */
/* ---------------------------------------------------------------------------------------------- */

definition ::=
    datatype_def
    | dimension_def
    | entity_def
    | enum_def
    | event_def
    | metric_def
    | metricGroup_def
    | property_def
    | rdf_def
    | structure_def
    | type_class_def
    | union_def

from_definition_clause ::=
    'from' mixin_clause

mixin_clause ::=
    identifier_reference mixin_member_choice

mixin_optional_clause ::=
    identifier_reference mixin_member_choice?

mixin_member_choice ::=
    mixin_with_members | mixin_without_members

mixin_with_members ::=
    'with' ( '_' | mixin_member_sequence )

mixin_without_members ::=
    'without' mixin_member_sequence

mixin_member_sequence ::=
    ( mixin_member | '[' mixin_member+ ']' )

mixin_member ::=
    identifier rename_as_clause?

datatype_def ::=
    'datatype' identifier datatype_derivation
     annotation_only_body?

datatype_derivation ::=
    type_op_restriction 'opaque'? datatype_base_type_reference
    datatype_restriction?

datatype_base_type_reference ::=
    identifier_reference | builtin_types

datatype_restriction ::=
    '{' restriction_facet+ '}'

restriction_facet ::=
    length_restriction_facet
    | digit_restriction_facet
    | value_restriction_facet
    | timezone_restriction_facet
    | pattern_restriction_facet

length_restriction_facet ::=
    ( 'length' | 'maxLength' | 'minLength' )
                            '=' 'fixed'? unsigned

digit_restriction_facet ::=
    ( 'fractionDigits' | 'totalDigits' )
    '=' 'fixed'? unsigned

value_restriction_facet ::=
    ( 'maxExclusive' | 'maxInclusive' | 'minExclusive' | 'minInclusive' )
    '=' 'fixed'? (simple_value | value_constructor)

timezone_restriction_facet ::=
    'explicitTimezone'
    '=' 'fixed'? ( 'required' | 'prohibited' | 'optional' )

pattern_restriction_facet ::=
    'pattern' '=' ( quoted_string | '[' quoted_string+ ']' )

annotation_only_body ::=
    'is' annotation+ 'end'

dimension_def ::=
    'dimension' identifier from_definition_clause? dimension_body?

dimension_body ::=
    'is' annotation* dimension_identity dimension_parent* member* 'end'

dimension_identity ::=
    source_entity | entity_identity

source_entity ::=
    'source' mixin_optional_clause

dimension_parent ::=
    'parent' identifier type_op_has_type identifer_reference annotation_only_body?

entity_def ::=
    'entity' identifier from_definition_clause? entity_body?

entity_body ::=
    'is' annotation* entity_identity member* 'end'

enum_def ::=
    'enum' identifier from_definition_clause? enum_body?

enum_body ::=
    'of' annotation* value_variant* 'end'

event_def ::=
    'event' identifier from_definition_clause? event_body?

event_body ::=
    'is' annotation* source_entity member* 'end'

metric_def ::=
    'metric' function_def

metric_groups_def ::=
    'metric' 'group' identifier metric_event_binding from_definition?
    metric_group_body?

metric_event_binding ::=
    'on' ( identifier_reference | '[' identifier_reference+ ']' )

metric_group_body ::=
    'is' annotation* ( metric_def | metric_ref )*

metric_ref ::=
    'ref' identifier_reference function_body?

property_def ::=
    'property' ( annotation_member_def | member_def )

rdf_def ::=
    'rdf' identifier rdf_types? annotation_only_body

rdf_types ::=
    type_op_rdf_has_type
    ( identifier_reference | '[' identifier_reference+ ']' )

structure_def ::=
    'structure' identifier from_definition_clause? structure_body?

structure_body ::=
    'is' annotation* member* 'end'

type_class_def ::=
    'class' identifier class_type_parameters? from_definition_clause?
    type_class_body?

class_type_parameters ::=
    '(' type_parameter+ ')'

type_parameter ::=
    identifier type_parameter_restrictions?

type_parameter_restrictions ::=
    type_op_restriction type_parameter_restriction
    ( type_op_combiner type_parameter_restriction )*

type_parameter_restriction ::=
    cardinality_reference_expression? identifier_reference
    ( '(' type_restriction_argument+ ')' )?

type_restriction_argument ::=
    wildcard | identifier

wildcard ::=
    '_'

type_class_body ::=
    'is' annotation* keyword_function_def 'end'

union_def ::=
    'union' identifier from_definition_clause? union_body?

union_body ::=
    'of' annotation* type_variant* 'end'

/* ---------------------------------------------------------------------------------------------- */

entity_identity ::=
    'identity' member

member ::=
    member_def | property_ref

member_def ::=
    identifier _type_expression annotation_only_body?

annotation_member_def ::=
    '@' member_def

property_ref ::=
    'ref' identifier_reference

type_variant ::=
    identifier_reference rename_as_clause? annotation_only_body?

value_variant ::=
    identifier annotation_only_body?

/* ---------------------------------------------------------------------------------------------- */

keyword_function_def ::=
    'def' function_def

function_def ::=
    function_signature function_body? annotation_only_body?

function_signature ::=
    identifier ( '(' function_parameter+ ')' )? function_type

function_parameter ::=
    identifier function_type

function_type ::=
    type_op_has_type cardinality_reference? function_type_ref

function_type_ref ::=
    identifer_reference | builtin_types | mapping_type

function_body ::=
    function_op_by_definition ( constraint_sentence | term )

/* ---------------------------------------------------------------------------------------------- */
/* Types & Type References                                                                        */
/* ---------------------------------------------------------------------------------------------- */

type_expression ::=
    type_op_has_type cardinality_expression? type_reference

type_reference ::=
    unknown_type | identifier_reference | builtin_types | mapping_type

unknown_type ::=
    'unknown'

builtin_types ::=
    owl_types | xsd_types | sdml_types

owl_types ::=
    'Nothing' | 'Thing' | 'rational' | 'real'

xsd_types ::=
    'anyURI'            | 'base64Binary'       | 'boolean'
    | 'date'            | 'dateTime'           | 'decimal'
    | 'double'          | 'duration'           | 'float'
    | 'gDay'            | 'gMonth'             | 'gMonthDay'
    | 'gYear'           | 'gYearMonth'         | 'hexBinary'
    | 'string'          | 'time'               | 'dateTimeStamp'
    | 'dayTimeDuration' | 'yearMonthDuration'  | 'integer'
    | 'long'            | 'int'                | 'short'
    | 'byte'            | 'nonNegativeInteger' | 'positiveInteger'
    | 'unsignedLong'    | 'unsignedInt'        | 'unsigned'
    | 'unsignedShort'   | 'unsignedByte'       | 'nonPositiveInteger'
    | 'negativeInteger' | 'normalizedString'   | 'token'
    | 'language'

mapping_type ::=
    '(' type_reference type_op_has_type type_reference ')'

cardinality_expression ::=
    '{'
    sequence_ordering? sequence_uniqueness? cardinality_inner
    '}'

cardinality_reference_expression ::=
    '{'
    sequence_ordering? sequence_uniqueness? cardinality_inner?
    '}'

cardinality_inner ::=
    unsigned cardinality_range?

cardinality_range ::=
    '..' unsigned?

sequence_ordering ::=
    'ordered' | 'unordered'

sequence_uniqueness ::=
    'unique' | 'nonunique'

/* ---------------------------------------------------------------------------------------------- */
/* Values, atomic and sequence                                                                    */
/* ---------------------------------------------------------------------------------------------- */

value ::=
    simple_value
    | value_constructor
    | identifier_reference
    | mapping_value
    | sequence_of_values

simple_value ::=
    boolean
    | unsigned
    | integer
    | rational
    | decimal
    | double
    | string
    | iri
    | binary

boolean ::=
    boolean_truth | boolean_falsity

boolean_truth ::=
    'true' | '⊤'

boolean_falsity ::=
    'false' | '⊥'

NUMERIC_SIGN ::=
    '+' | '-'

POSITIVE_UNSIGNED ::=
    [1-9] ASCII_DIGIT*

unsigned ::=
    '0' | POSITIVE_UNSIGNED

integer ::=
    NUMERIC_SIGN? unsigned

rational ::=
    integer ( '/' | '⁄' ) POSITIVE_UNSIGNED

decimal ::=
    integer '.' ASCII_DIGIT+

double ::=
    decimal ( 'e' | 'E' ) NUMERIC_SIGN? integer

string ::=
    quoted_string language_tag?

quoted_string ::=
    '"' ( CHAR_PRINTABLE | character_esc | unicode_esc )* '"'

CHAR_PRINTABLE ::=
    [^\x00-\x08\x0B-\x1F\x7F\"]

CHAR_ESCAPED ::=
    [abefnrtv/"]

character_esc ::=
    '\\' CHAR_ESCAPED

unicode_esc ::=
    '\\u{' HEX_DIGIT_PAIR HEX_DIGIT_PAIR?
           HEX_DIGIT_PAIR? HEX_DIGIT_PAIR? '}'

HEX_DIGIT_PAIR ::=
    ASCII_HEX_DIGIT ASCII_HEX_DIGIT

language_tag ::=
    LANGUAGE_TAG_PRIMARY
    LANGUAGE_TAG_EXTENDED?
    LANGUAGE_TAG_SCRIPT?
    LANGUAGE_TAG_REGION?

LANGUAGE_TAG_PRIMARY ::=
    '@' ASCII_LETTER_LOWER ASCII_LETTER_LOWER
        ASCII_LETTER_LOWER?

LANGUAGE_TAG_EXTENDED ::=
    '-' ASCII_LETTER_UPPER
        ASCII_LETTER_UPPER ASCII_LETTER_UPPER

LANGUAGE_TAG_SCRIPT ::=
    '-' ASCII_LETTER_UPPER ASCII_LETTER_LOWER
        ASCII_LETTER_LOWER ASCII_LETTER_LOWER

LANGUAGE_TAG_REGION ::=
    '-' ( ( ASCII_LETTER_UPPER ASCII_LETTER_UPPER )
          | ( ASCII_DIGIT ASCII_DIGIT ASCII_DIGIT ) )

iri ::=
    '<'
    ( IRI_CHAR_ALLOWED | unicode_esc )*
    '>'

IRI_CHAR_ALLOWED ::=
    [^<>\"{}|^`\\\x00-\x20]

binary ::=
    '#[' hex_byte* ']'

hex_byte ::=
    HEX_DIGIT_PAIR

value_constructor ::=
    identifier_reference '(' simple_value ')'

mapping_value ::=
    simple_value type_op_has_type value

sequence_of_values ::=
    sequence_value_constraint?
    ( value_empty_sequence | '[' sequence_member* ']' )

sequence_value_constraint ::=
    '{'
    ( ( sequence_ordering sequence_uniqueness? )
    | ( sequence_ordering? sequence_uniqueness ) )
    '}'

sequence_member ::=
    simple_value
    | value_constructor
    | mapping_value
    | identifier_reference
    
value_empty_sequence ::=
    '∅'

/* ---------------------------------------------------------------------------------------------- */
/* Constraints, formal and informal                                                               */
/* ---------------------------------------------------------------------------------------------- */

constraint ::=
    'assert' identifier
    ( informal_constraint | formal_constraint )

informal_constraint ::=
    '=' quoted_string controlled_language_tag?

controlled_language_tag ::=
    LANGUAGE_TAG_PRIMARY CONTROLLED_LANGUAGE_SCHEME?

controlled_language_scheme ::=
    '-' ASCII_LETTER  ASCII_LETTER  ASCII_LETTER
        ASCII_LETTER? ASCII_LETTER? ASCII_LETTER?
        ASCII_LETTER? ASCII_LETTER? ASCII_LETTER?

formal_constraint ::=
    'is' constraint_sentence 'end'

constraint_sentence ::=
    simple_sentence
    | boolean_sentence
    | expression_sentence
    | quantified_sentence
    | sentence_with_environment
    | '(' constraint_sentence ')'

sentence_with_environment ::=
    'with' keyword_function_def+
    'for' constraint_sentence 'end'

simple_sentence ::=
    atomic | equation | inequation

atomic ::=
    term _actual_arguments

_actual_arguments ::=
    '(' term* ')'

equation ::=
    term op_equality term

inequation ::=
    term inequality_relation term

boolean_sentence ::=
    unary_boolean_sentence | binary_boolean_sentence

unary_boolean_sentence ::=
    logical_op_negation constraint_sentence

binary_boolean_sentence ::=
    constraint_sentence logical_connective constraint_sentence

expression_sentence ::=
    set_expression_sentence | arithmetic_expression_sentence

set_expression_sentence ::=
    term set_operator term

arithmetic_expression_sentence ::=
    term math_operator term

quantified_sentence ::=
    quantified_variable_binding+ ',' constraint_sentence

quantified_variable_binding ::=
    logical_quantifier quantified_variable

quantified_variable ::=
    variable membership_operator term

variable ::=
    identifier ( type_op_has_type identifer_reference )?

term ::=
    sequence_builder
    | functional_term
    | function_composition
    | identifier_reference
    | reserved_self
    | reserved_event
    | predicate_value

sequence_builder ::=
    '{' variable+ '|' quantified_sentence '}'

functional_term ::=
    term _actual_arguments

function_composition ::=
    ( reserved_self | reserved_event | identifier )
    ( function_op_composition identifier )+

predicate_value ::=
    simple_value | sequence_of_predicate_values

sequence_of_predicate_values ::=
    sequence_value_constraint?
    ( value_empty_sequence | '[' predicate_sequence_member* ']' )

predicate_sequence_member ::=
    predicate_value
    | value_constructor
    | mapping_value
    | identifier_reference

reserved_self ::=
    'self'

reserved_event ::=
    'event'

/* ---------------------------------------------------------------------------------------------- */
/* Operators -- All                                                                               */
/* ---------------------------------------------------------------------------------------------- */

op_equality ::=
    term '=' term

inequality_relation ::=
    term
    ( op_inequality
      | op_greater_than
      | op_greater_than_or_equal
      | op_less_than
      | op_less_than_or_equal )
    term

op_inequality ::=
    '/=' | '≠'

op_greater_than ::=
    '>'

op_greater_than_or_equal ::=
    '>=' | '≥'

op_less_than ::=
    '<'

op_less_than_or_equal ::=
    '<=' | '≤'

logical_connective ::=
    logical_conjunction
    | logical_disjunction
    | logical_excl_disjunction
    | logical_implication
    | logical_biconditional

logical_op_negation ::=
    'not' | '¬'

logical_conjunction ::=
    'and' | '∧'

logical_disjunction ::=
    'or' | '∨'

logical_excl_disjunction ::=
    'xor' | '⊻'

logical_implication ::=
    'implies' | '==>' | '⇒'

logical_biconditional ::=
    'iff' | '<==>' | '⇔'

logical_quantifier ::=
    logical_quantifier_universal
    | logical_quantifier_existential
    | logical_quantifier_existential_one
    | logical_quantifier_neg_existential

logical_quantifier_universal ::=
    'forall' | '∀'

logical_quantifier_existential ::=
    'exists' | '∃'

logical_quantifier_existential_one ::=
    'exists!' | '∃!'

logical_quantifier_not_existential ::=
    '∄'

set_operator ::=
    set_op_union
    | set_op_disjoint_union
    | set_op_intersection
    | set_op_subset
    | set_op_subset_or_equal
    | set_op_supset
    | set_op_supset_or_equal
    | set_op_complement
    | set_op_product
    | set_membership

set_op_union ::=
    'union' | '∪'

set_op_disjoint_union ::=
    'disunion' | '⊔'

set_op_intersection ::=
    'intersects' | '∩'

set_op_difference ::=
    'difference' | '△'

set_op_subset ::=
    'subset' | '⊂'

set_op_subset_or_equal ::=
    'subseteq' | '⊆'

set_op_supset ::=
    'supset' | '⊃'

set_op_supset_or_equal ::=
    'supseteq ' | '⊇'

set_op_complement ::=
    'complement' | '∖'

set_op_product ::=
    'product' | '∏'

set_membership ::=
    set_op_is_member | set_op_is_not_member

set_op_is_member ::=
    'in' | '∈'

set_op_is_not_member ::=
    ( LogicalNegation IsMemberOperator ) | '∉'

math_operator ::=
    math_op_multiply
    | math_op_divide
    | math_op_modulo
    | math_op_add
    | math_op_subtract

math_op_multiply ::=
    '*' | '×'

math_op_divide ::=
    '/' | '÷'

math_op_modulo ::=
    'mod' | '%'

math_op_add ::=
    '+'

math_op_subtract ::=
    '-'

function_op_composition ::=
    '.' | '∘'

function_op_by_definition ::=
    ':=' | '≔'

type_op_has_type ::=
    '->' | '→'

type_op_rdf_has_type ::=
    'a' | 'type'

type_op_restriction ::=
    '<-' | '←'

type_op_combiner ::=
    '+'

/* ---------------------------------------------------------------------------------------------- */
/* Comment Forms                                                                                  */
/* ---------------------------------------------------------------------------------------------- */

line_comment ::=
    comment_aligned | comment_local | comment_page

comment_aligned ::=
    ';' [^;] [^\r\n]*

comment_local ::=
    ';;' [^;] [^\r\n]*

comment_page ::=
    ';;;' [^\r\n]*

/* ---------------------------------------------------------------------------------------------- */
/* Common Whitespace (ignore)                                                                     */
/* ---------------------------------------------------------------------------------------------- */

whitespace ::=
    [^\f\n\r\t\v#x20#xa0#x1680#x2000#x200a#x2028#x2029#x202f#x205f#x3000#xfeff]
